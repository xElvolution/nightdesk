# NightDesk venue adapter
# Leave unset to prefer Bitget public tickers with automatic recorded-tape failover.
# Set NIGHTDESK_FEED=recorded to force the recorded tape (reconnect + rate-limit behaviour).

NIGHTDESK_FEED=

# Optional Bitget credentials for authenticated Agent Hub / trade routes later.
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# Cookie session signing (optional; local default used if unset).
NIGHTDESK_SESSION_SECRET=
